#!/bin/sh
start() {
    /etc/init.d/S48sntp start 2>/dev/null &
    for i in $(seq 1 30); do
        if ! date | grep -q 1970; then break; fi
        sleep 1
    done
    echo "Starting PureFox Tidal Connect..."
    if [ -f /opt/tidal.sqfs ] && ! mountpoint -q /opt/tidal; then
        mkdir -p /opt/tidal && mount -t squashfs -o loop,ro /opt/tidal.sqfs /opt/tidal
    fi
    export LD_LIBRARY_PATH=/opt/tidal
    export LD_PRELOAD=/opt/tidal/libdns_sd.so
    /usr/sbin/tc_volume >/dev/null 2>&1 &
    tidalconnect --tc-certificate-path /opt/tidal/T1.dat -f PureFox --model-name PureFox --codec-mqa false --disable-web-security true --log-level 0 >/dev/null 2>&1 &
    sleep 2
    ps | grep -E 'tidalconnect|tc_volume|avahi-publish' | grep -v grep | awk '{print $1}' | while read pid; do
        renice -15 $pid 2>/dev/null
    done
}
stop() {
    killall -9 tc_volume tidalconnect 2>/dev/null
    killall avahi-publish-service 2>/dev/null
}
case "$1" in start) start ;; stop) stop ;; restart) stop; sleep 1; start ;; esac
