pcm.!default {
    type route
    slave.pcm {
        type multi
        slaves.i2s.pcm  "hw:0,0"
        slaves.i2s.channels 2
        slaves.loop.pcm "hw:Loopback,0"
        slaves.loop.channels 2
        bindings.0.slave i2s   bindings.0.channel 0
        bindings.1.slave i2s   bindings.1.channel 1
        bindings.2.slave loop  bindings.2.channel 0
        bindings.3.slave loop  bindings.3.channel 1
    }
    slave.channels 4
    ttable.0.0 1
    ttable.1.1 1
    ttable.0.2 1
    ttable.1.3 1
}
ctl.!default { type hw; card 0 }
